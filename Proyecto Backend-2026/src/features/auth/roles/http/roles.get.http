@baseUrl = http://localhost:3002/api
@accessToken = REPLACE_WITH_A_VALID_ACCESS_TOKEN
@roleId = 1

### List active roles
GET {{baseUrl}}/roles
Authorization: Bearer {{accessToken}}

### Get one active role
GET {{baseUrl}}/roles/{{roleId}}
Authorization: Bearer {{accessToken}}

### Create role
POST {{baseUrl}}/roles
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "AUDITOR",
  "description": "Auditoría de operaciones",
  "status": "active"
}

### Replace role fields
PUT {{baseUrl}}/roles/{{roleId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "AUDITOR",
  "description": "Auditoría del sistema"
}

### Patch role fields
PATCH {{baseUrl}}/roles/{{roleId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "description": "Auditoría de operaciones"
}

### Deactivate role
PATCH {{baseUrl}}/roles/{{roleId}}/deactivate
Authorization: Bearer {{accessToken}}

### Permanently delete role
DELETE {{baseUrl}}/roles/{{roleId}}
Authorization: Bearer {{accessToken}}
