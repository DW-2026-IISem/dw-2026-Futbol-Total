@baseUrl = http://localhost:3002/api
@adminToken = REPLACE_WITH_ADMIN_ACCESS_TOKEN
@sellerToken = REPLACE_WITH_SELLER_ACCESS_TOKEN
@roleId = 1

### List active roles as ADMIN
GET {{baseUrl}}/roles
Authorization: Bearer {{adminToken}}

### Get one active role as ADMIN
GET {{baseUrl}}/roles/{{roleId}}
Authorization: Bearer {{adminToken}}

### Create role as ADMIN
POST {{baseUrl}}/roles
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "AUDITOR",
  "description": "Auditoría de operaciones",
  "status": "active"
}

### Replace role fields as ADMIN
PUT {{baseUrl}}/roles/{{roleId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "AUDITOR",
  "description": "Auditoría del sistema"
}

### Patch role fields as ADMIN
PATCH {{baseUrl}}/roles/{{roleId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "description": "Auditoría de operaciones"
}

### Deactivate role as ADMIN
PATCH {{baseUrl}}/roles/{{roleId}}/deactivate
Authorization: Bearer {{adminToken}}

### Permanently delete role as ADMIN
DELETE {{baseUrl}}/roles/{{roleId}}
Authorization: Bearer {{adminToken}}

### SELLER should be forbidden from listing roles (expect 403)
GET {{baseUrl}}/roles
Authorization: Bearer {{sellerToken}}
